{
  "name": "maybe-something-seasonal",
  "version": "1.0.0",
  "description": "A seasonal calendar with ICS generation and React viewer",
  "main": "index.js",
  "scripts": {
    "generate-images": "node scripts/generate-images.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build",
    "validate": "node scripts/validate-ics.js",
    "fix:ics-format": "node scripts/fix-ics-format.js",
    "fix:images": "node scripts/fix-missing-images.js",
    "test:local": "npm run validate && npm run build && npm run preview",
    "precommit": "npm run validate",
    "prepare": "npx simple-git-hooks"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "sharp": "^0.34.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "keywords": [
    "calendar",
    "ics",
    "seasonal",
    "react"
  ],
  "author": "Daniel McShan",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-push": "npm run validate"
  }
}
